{
  "manifest_version": 3,
  "name": "Apply Kit",
  "version": "0.1.0",
  "description": "Fill job applications from your saved profile, or pick a value for any field with a keyboard shortcut.",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_title": "Apply Kit — fill this page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "fill-page": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill this job application"
    },
    "show-picker": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Pick a saved value for the focused field"
    }
  }
}
